---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { localeMeta, type Lang } from '../i18n/ui';
import { formatDate, isoDate, localizePath, readingTime, useTranslations } from '../i18n/utils';
import {
  authorSchema,
  blogPostingSchema,
  breadcrumbSchema,
  buildGraph,
  faqSchema,
  publisherSchema,
  websiteSchema,
} from '../lib/seo';
import { getRelatedPosts, getTranslation, postSlug, type Post } from '../lib/posts';
import PostCard from './PostCard.astro';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const lang = post.data.lang as Lang;
const otherLang: Lang = lang === 'he' ? 'en' : 'he';
const t = useTranslations(lang);

const { Content } = await render(post);

const translation = await getTranslation(post, otherLang);
const related = await getRelatedPosts(post);

const path = localizePath(lang, `/blog/${postSlug(post)}`);
const alternates: Partial<Record<Lang, string>> = { [lang]: path };
if (translation) {
  alternates[otherLang] = localizePath(otherLang, `/blog/${postSlug(translation)}`);
}

const body = post.body ?? '';
const minutes = readingTime(body, lang);
const wordCount = body.trim().split(/\s+/).filter(Boolean).length;

const jsonLd = buildGraph([
  websiteSchema(lang, Astro.site),
  publisherSchema(lang, Astro.site),
  authorSchema(lang, Astro.site),
  blogPostingSchema(
    {
      title: post.data.title,
      description: post.data.description,
      url: path,
      lang,
      pubDate: post.data.pubDate,
      updatedDate: post.data.updatedDate,
      tags: post.data.tags,
      image: post.data.heroImage,
      places: post.data.places,
      wordCount,
    },
    Astro.site,
  ),
  breadcrumbSchema(
    [
      { name: t('nav.home'), url: localizePath(lang, '/') },
      { name: t('blog.title'), url: localizePath(lang, '/blog') },
      { name: post.data.title, url: path },
    ],
    Astro.site,
  ),
  faqSchema(post.data.faq),
]);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  lang={lang}
  alternates={alternates}
  type="article"
  image={post.data.heroImage}
  jsonLd={jsonLd}
>
  <div class="wrap">
    <article class="prose">
      <header>
        <p class="post-meta">
          <a href={localizePath(lang, '/blog')}>{t('blog.backToBlog')}</a>
        </p>
        <h1>{post.data.title}</h1>
        <p class="post-meta">
          <time datetime={isoDate(post.data.pubDate)}>
            {t('post.publishedOn')} {formatDate(post.data.pubDate, lang)}
          </time>
          {
            post.data.updatedDate && (
              <>
                <span class="post-meta__sep" aria-hidden="true">
                  &middot;
                </span>
                <time datetime={isoDate(post.data.updatedDate)}>
                  {t('post.updatedOn')} {formatDate(post.data.updatedDate, lang)}
                </time>
              </>
            )
          }
          <span class="post-meta__sep" aria-hidden="true">&middot;</span>
          <span>{minutes} {t('post.minutes')}</span>
        </p>
      </header>

      {
        post.data.heroImage && (
          <img
            src={post.data.heroImage}
            alt={post.data.heroImageAlt ?? ''}
            width="1200"
            height="630"
            loading="eager"
            style="border-radius: var(--radius); margin-block: 1.5rem;"
          />
        )
      }

      {
        translation && (
          <p class="translation-note" data-dir={localeMeta[otherLang].dir}>
            <a
              href={alternates[otherLang]}
              lang={localeMeta[otherLang].htmlLang}
              hreflang={localeMeta[otherLang].hreflang}
              rel="alternate"
            >
              {t('post.translationAvailable')}
            </a>
          </p>
        )
      }

      {/* Placed before the body so both readers and answer engines hit the
          conclusions first. */}
      {
        post.data.takeaways.length > 0 && (
          <aside class="callout" aria-labelledby="takeaways">
            <h2 id="takeaways">{t('post.takeaways')}</h2>
            <ul>
              {post.data.takeaways.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </aside>
        )
      }

      <Content />

      {
        post.data.faq.length > 0 && (
          <section class="faq" aria-labelledby="faq">
            <h2 id="faq">{t('post.faq')}</h2>
            {post.data.faq.map((item) => (
              <details>
                <summary>{item.q}</summary>
                <p>{item.a}</p>
              </details>
            ))}
          </section>
        )
      }

      {
        post.data.tags.length > 0 && (
          <footer style="margin-block-start: 2.5rem;">
            <h2 class="visually-hidden">{t('post.tags')}</h2>
            <ul class="tag-list">
              {post.data.tags.map((tag) => (
                <li>
                  <a class="tag" href={localizePath(lang, `/tags/${encodeURIComponent(tag)}`)}>
                    {tag}
                  </a>
                </li>
              ))}
            </ul>
          </footer>
        )
      }
    </article>

    {
      related.length > 0 && (
        <section aria-labelledby="related" style="margin-block-start: 3rem;">
          <div class="section-head">
            <h2 id="related">{t('post.related')}</h2>
          </div>
          <ul class="post-grid">
            {related.map((item) => (
              <PostCard post={item} lang={lang} headingLevel="h3" />
            ))}
          </ul>
        </section>
      )
    }
  </div>
</BaseLayout>
